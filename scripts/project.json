{
  "name": "acquisition-report",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "scripts",
  "targets": {
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run scripts" } },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p scripts/tsconfig.json --noEmit" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "tsx node_modules/oxlint/bin/oxlint scripts" }
    }
  },
  "tags": ["scope:operations", "type:tool"]
}
