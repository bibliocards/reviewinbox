{
  "name": "reviewinbox",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "nx run-many -t serve -p api web --tui=false",
    "serve:api": "nx serve api",
    "serve:worker": "nx serve worker",
    "serve:web": "nx serve web",
    "serve:site": "nx serve site",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "tsx node_modules/oxlint/bin/oxlint .",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "db:generate": "tsx scripts/generate-migration.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:clear": "docker compose exec -T postgres psql -U reviewinbox -d reviewinbox -c \"DROP SCHEMA IF EXISTS drizzle CASCADE; DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public;\"",
    "db:reset": "pnpm db:clear && pnpm db:migrate",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "report:acquisition": "tsx --tsconfig tsconfig.base.json scripts/acquisition-funnel.ts",
    "lint:fix": "tsx node_modules/oxlint/bin/oxlint . --fix && oxfmt ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.71",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/service-worker": "22.1.7",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@better-auth/stripe": "^1.7.5",
    "@hono/node-server": "^2.1.1",
    "@jsverse/transloco": "^8.4.0",
    "@primeuix/themes": "^3.0.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "better-auth": "^1.7.5",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "ngx-better-auth": "^1.7.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "primeicons": "^8.0.1",
    "primeng": "^22.1.1",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2",
    "tsx": "4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular/build": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.42.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nx/angular": "23.2.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "astro": "^7.3.3",
    "drizzle-kit": "^0.31.10",
    "eslint-plugin-sonarjs": "4.2.1",
    "nx": "23.2.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#v0.1.2",
    "oxlint-tsgolint": "7.0.2002",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=26.9.0 <27",
    "pnpm": ">=12.5.1 <13"
  },
  "packageManager": "pnpm@12.5.1"
}
