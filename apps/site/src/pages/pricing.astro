---
import SiteHeader from '../components/SiteHeader.astro'
import SiteIcons from '../components/SiteIcons.astro'
import SiteFooter from '../components/SiteFooter.astro'

import { cloudPlans, comparisonRows } from '../lib/pricing'
import '../styles.css'

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:4200'
const planSignUpUrl = (plan: string) => {
  const url = new URL('/sign-up', appUrl)
  url.searchParams.set('plan', plan)
  return url.toString()
}
const siteUrl = 'https://reviewinbox.app/pricing/'
const ogImageUrl = new URL('/screenshots/reply-inbox-hero.png', 'https://reviewinbox.app/').toString()
const pageTitle = 'ReviewInbox Pricing | App Store & Google Play review workflows'
const pageDescription = 'ReviewInbox pricing plans for Cloud and self-hosted deployments, including Review imports, Managed AI Reply Drafts, Apps, Store Connections, and members.'

---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090B" />
    <SiteIcons />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="ReviewInbox" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="ReviewInbox Reply Inbox with app reviews and reply drafts" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1439" />
    <meta property="og:image:height" content="910" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="ReviewInbox Reply Inbox with app reviews and reply drafts" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;family=Geist+Mono:wght@400;500&amp;display=swap" rel="stylesheet" />
  </head>
  <body class="[&_:focus-visible]:outline-site-link overflow-x-visible bg-site-canvas font-site-sans text-site-ink">
    <SiteHeader pricing />
    <main id="main" tabindex="-1">
      <section class="max-w-300 mx-auto pbs-22 px-6 pbe-12 flex flex-col items-center text-center gap-5">
        <span class="text-[13px] font-medium tracking-[0.04em] text-site-primary-text">Pricing</span>
        <h1 class="m-0 text-[length:clamp(40px,_5.6vw,_72px)] leading-[1.04] tracking-[-0.045em] font-semibold max-w-215">Pay for convenience.<br><span class="text-site-heading-muted">The core stays open source.</span></h1>
        <p class="m-0 text-[18px] text-site-muted max-w-155">Cloud plans attach to an Organization and cover hosting, scheduling, backups and managed AI drafts. Self-hosted ReviewInbox has no billing limits.</p>
      </section>

      <section class="max-w-300 mx-auto pbs-6 px-6 pbe-20">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-4">
          {cloudPlans.map((plan) => (
          <article class:list={['grid row-span-4 grid-rows-subgrid gap-y-5 rounded-lg border p-7', plan.id === 'starter' ? 'border-site-featured-border bg-site-featured' : 'border-site-border bg-site-surface']}>
            <div class="flex flex-col gap-1.5">
              <h2 class="text-[17px] font-semibold">{plan.name}</h2>
              <p class="text-sm text-site-muted">{plan.description}</p>
            </div>
            <p class="text-[44px] font-semibold leading-none tracking-[-1.5px] tabular-nums">{plan.price}<span class="ms-1 text-[15px] font-normal tracking-normal text-site-subtle">/month</span></p>
            <a href={planSignUpUrl(plan.id)} class:list={['inline-flex min-h-11 items-center justify-center rounded-md px-4 py-3 text-sm font-medium active:brightness-90', plan.id === 'starter' ? 'bg-site-primary text-white [@media(hover:hover)_and_(pointer:fine)]:hover:bg-site-primary/90' : 'border border-site-border-strong text-site-ink [@media(hover:hover)_and_(pointer:fine)]:hover:bg-site-selected']}>
              {plan.id === 'free' ? 'Start free' : `Select ${plan.name}`}
            </a>
            <ul class:list={['flex flex-col gap-2.5 border-bs pbs-5 text-sm text-site-body', plan.id === 'starter' ? 'border-site-featured-divider' : 'border-site-hairline']}>
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
          ))}
        </div>

        <div class="mbs-4 border border-dashed border-site-border-strong rounded-lg p-7 flex flex-wrap gap-6 items-center justify-between">
          <div class="min-w-0 flex-[1_1_480px] flex flex-col gap-[6px]">
            <div class="flex items-center gap-[10px] flex-wrap"><span class="font-semibold text-[17px]">Self-hosted</span><span class="bg-site-success-bg text-site-success rounded-full py-[2px] px-[10px] text-[12px]">Apache 2.0</span></div>
            <span class="text-[15px] text-site-muted">Run ReviewInbox yourself without Cloud billing limits. You operate the AI provider, Postgres, backups, SMTP, storage and updates.</span>
          </div>
          <div class="flex flex-wrap gap-[10px]">
            <a href="/docs/self-hosting/" class="border border-site-border-strong text-site-ink no-underline font-medium py-3 px-4 rounded-md text-[14px] inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Self-hosting guide</a>
            <a href="https://github.com/bibliocards/reviewinbox" target="_blank" rel="noopener noreferrer" class="border border-site-border-strong text-site-ink no-underline font-medium py-3 px-4 rounded-md text-[14px] inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">View on GitHub</a>
          </div>
        </div>
      </section>

      <section class="border-bs border-site-hairline bg-site-alt">
        <div class="max-w-300 mx-auto py-24 px-6 flex flex-col gap-8">
          <h2 class="m-0 text-[length:clamp(28px,_3.4vw,_40px)] leading-[1.1] tracking-[-0.03em] font-semibold">Compare plans</h2>
          <div role="region" aria-label="Cloud plan comparison" tabindex="0" class="overflow-x-auto border border-site-border rounded-lg">
            <table class="tabular-nums w-full min-w-190 border-collapse text-[14px]">
              <caption class="sr-only">Monthly Cloud plan limits by Organization</caption><thead>
                <tr class="text-start text-site-muted">
                  <th scope="col" class="border-be border-site-border px-5 py-4 font-medium"><span class="sr-only">Feature</span></th>
                  {cloudPlans.map((plan) => <th scope="col" class:list={['border-be border-site-border px-5 py-4 font-semibold text-site-ink', { 'bg-site-featured': plan.id === 'starter' }]}>{plan.name}</th>)}
                </tr>
              </thead>
              <tbody class="text-site-body">
                {comparisonRows.map(([label, key]) => (
                <tr class="border-be border-site-hairline last:border-0">
                  <th scope="row" class="px-5 py-3.5 text-start font-normal text-site-muted">{label}</th>
                  {cloudPlans.map((plan) => <td class:list={['px-5 py-3.5', { 'bg-site-featured': plan.id === 'starter' }]}>{plan[key]}</td>)}
                </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="border-bs border-site-hairline">
        <div class="max-w-300 mx-auto py-24 px-6 flex flex-wrap gap-12">
          <h2 class="min-w-0 flex-[1_1_320px] m-0 text-[length:clamp(28px,_3.4vw,_40px)] leading-[1.1] tracking-[-0.03em] font-semibold">Billing questions</h2>
          <div class="min-w-0 flex-[999_1_560px] flex flex-col">
            <details open class="border-bs border-site-border py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium">Who is a plan attached to?</summary>
              <p class="mbs-3 text-site-muted max-w-160">Plans attach to Organizations, not individual users. A user can belong to several Organizations, each with its own limits and usage.</p>
            </details>
            <details class="border-bs border-site-border py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium">Do usage limits apply when self-hosting?</summary>
              <p class="mbs-3 text-site-muted max-w-160">No. Usage limits apply to Cloud deployments only. Self-hosted deployments stay billing-free.</p>
            </details>
            <details class="border-bs border-site-border border-be py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium">What counts as an AI Reply Draft?</summary>
              <p class="mbs-3 text-site-muted max-w-160">Usage counts when managed AI creates a Reply Draft. Manual drafts, manual edits, and failed generation without a created draft do not count.</p>
            </details>
            <a href="/docs/usage-limits/" class="mbs-5 text-[15px] font-medium text-site-link inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Read the usage limits docs →</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
