---
import SiteHeader from '../components/SiteHeader.astro'
import SiteIcons from '../components/SiteIcons.astro'
import SiteFooter from '../components/SiteFooter.astro'

import { cloudPlans } from '../lib/pricing'
import '../styles.css'

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:4200'
const signUpUrl = new URL('/sign-up', appUrl).toString()
const siteUrl = 'https://reviewinbox.app/'
const ogImageUrl = new URL('/screenshots/reply-inbox-hero.png', siteUrl).toString()
const pageTitle = 'ReviewInbox | App Store & Google Play review inbox'
const pageDescription = 'Bring App Store and Google Play reviews into one inbox. Draft replies with AI, edit them, and publish when ready.'
const pageKeywords = [
  'ReviewInbox',
  'app review management',
  'app store reviews',
  'Google Play reviews',
  'App Store reviews',
  'reply inbox',
  'AI reply drafts',
  'app review reply tool',
  'mobile app support',
  'app review analysis',
  'review topics and severity',
  'self-hosted review management',
]

---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords.join(', ')} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#08090B" />
    <SiteIcons />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="ReviewInbox" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="ReviewInbox Reply Inbox with app reviews and reply drafts" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1439" />
    <meta property="og:image:height" content="910" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="ReviewInbox Reply Inbox with app reviews and reply drafts" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'ReviewInbox',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      url: siteUrl,
      description: pageDescription,
      keywords: pageKeywords,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
    })}></script>
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&amp;family=Geist+Mono:wght@400;500&amp;display=swap" rel="stylesheet" />
  </head>
  <body class="[&_:focus-visible]:outline-site-link overflow-x-visible bg-site-canvas font-site-sans text-site-ink">
    <SiteHeader />
    <main id="main" tabindex="-1">
      <section class="max-w-300 mx-auto pbs-24 px-6 pbe-14 flex flex-col items-start gap-7">
        <a href="/docs/self-hosting/" class="inline-flex items-center gap-[10px] text-[13px] text-site-body no-underline border border-site-border rounded-full pbs-[6px] pe-[14px] pbe-[6px] ps-[6px] bg-site-surface min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">
          <span class="bg-site-success-bg text-site-success rounded-full py-[2px] px-2 text-[12px] font-medium">Open source</span>
          Self-host with Docker Compose, or use the Cloud →
        </a>
        <h1 class="m-0 text-[length:clamp(40px,_6.4vw,_84px)] leading-[1.02] tracking-[-0.045em] font-semibold max-w-245">Every store review answered.<br><span class="text-site-heading-muted">Nothing published without you.</span></h1>
        <p class="m-0 text-[19px] leading-[1.55] text-site-muted max-w-160">ReviewInbox brings App Store and Google Play reviews into one Reply Inbox, drafts replies with AI, and shows the recurring pain behind them. Your team edits and approves every reply.</p>
        <div class="flex flex-wrap gap-3">
          <a href={signUpUrl} class="bg-site-primary text-white no-underline font-medium py-[13px] px-5 rounded-md text-[15px] inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-site-primary/90">Start free — 1 App included</a>
          <a href="/docs/self-hosting/" class="border border-site-border-strong text-site-ink no-underline font-medium py-[13px] px-5 rounded-md text-[15px] bg-site-surface inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Self-host it</a>
        </div>
        <div class="flex flex-wrap gap-y-2 gap-x-5 text-[13px] text-site-subtle">
          <span>App Store</span><span aria-hidden="true">·</span><span>Google Play</span><span aria-hidden="true">·</span><span>Bring your own AI provider</span><span aria-hidden="true">·</span><span>Apache 2.0 on GitHub</span>
        </div>
      </section>

      <section id="product" class="scroll-mbs-6 max-w-300 mx-auto pbs-0 px-6 pbe-28">
        <div class="border border-site-border rounded-xl bg-site-panel shadow-site-panel overflow-clip">
          <div class="flex items-center gap-2 py-3 px-4 border-be border-site-hairline text-[12px] text-site-subtle font-site-mono">
            <span class="w-[10px] h-[10px] rounded-full bg-site-window-dot"></span><span class="w-[10px] h-[10px] rounded-full bg-site-window-dot"></span><span class="w-[10px] h-[10px] rounded-full bg-site-window-dot"></span>
            <span class="ms-3">Reply Inbox · illustrative preview</span>
          </div>
          <div class="flex flex-wrap">
            <div class="min-w-0 flex-[1_1_300px] border-e border-site-hairline p-4 flex flex-col gap-2">
              <div class="flex justify-between items-center pbs-1 px-1 pbe-2">
                <span class="font-semibold text-[15px]">Reply Inbox</span>
                <span class="text-[12px] text-site-subtle font-site-mono">Illustrative preview</span>
              </div>
              <div class="bg-site-selected border border-site-border-strong rounded-[10px] py-3 px-[14px] flex flex-col gap-[6px]">
                <div class="flex gap-2 items-center text-[12px] text-site-muted"><span class="text-site-severity-medium">★★☆☆☆</span><span>Google Play</span><span class="ms-auto text-site-subtle">2h</span></div>
                <div class="text-[14px] font-medium">Sync lost my decks after update</div>
                <div class="text-[13px] text-site-subtle whitespace-nowrap overflow-clip text-ellipsis">Since 4.2 my cards don't sync between phone and…</div>
              </div>
              <div class="border border-transparent rounded-[10px] py-3 px-[14px] flex flex-col gap-[6px]">
                <div class="flex gap-2 items-center text-[12px] text-site-muted"><span class="text-site-severity-medium">★★★★★</span><span>App Store</span><span class="ms-auto text-site-subtle">5h</span></div>
                <div class="text-[14px] font-medium">Best flashcard app I've tried</div>
                <div class="text-[13px] text-site-subtle whitespace-nowrap overflow-clip text-ellipsis">Clean, fast, and the spaced repetition just works…</div>
              </div>
              <div class="border border-transparent rounded-[10px] py-3 px-[14px] flex flex-col gap-[6px]">
                <div class="flex gap-2 items-center text-[12px] text-site-muted"><span class="text-site-severity-medium">★★★☆☆</span><span>App Store</span><span class="ms-auto text-site-subtle">1d</span></div>
                <div class="text-[14px] font-medium">Please add a dark mode</div>
                <div class="text-[13px] text-site-subtle whitespace-nowrap overflow-clip text-ellipsis">Studying at night hurts my eyes, would love…</div>
              </div>
            </div>
            <div class="min-w-0 flex-[999_1_520px] p-7 flex flex-col gap-5">
              <div class="flex flex-wrap gap-2 items-center text-[12px]">
                <span class="bg-site-success-bg text-site-success rounded-sm py-[3px] px-2">Drafted</span>
                <span class="border border-site-border-strong rounded-sm py-[2px] px-2 text-site-body">Google Play</span>
                <span class="border border-site-border-strong rounded-sm py-[2px] px-2 text-site-body">v4.2.0</span>
                <span class="border border-site-warning-border bg-site-warning-bg rounded-sm py-[2px] px-2 text-site-severity-medium">Severity: high</span>
                <span class="border border-site-border-strong rounded-sm py-[2px] px-2 text-site-body">Topic: Sync</span>
              </div>
              <div>
                <div class="text-[22px] font-semibold tracking-[-0.4px]">Sync lost my decks after update</div>
                <p class="mbs-2 text-site-body text-[15px]">Since 4.2 my cards don't sync between phone and tablet anymore. I lost two weeks of reviews. Please fix this.</p>
              </div>
              <div class="border border-site-border-strong rounded-lg bg-site-draft py-[18px] px-5 flex flex-col gap-[10px]">
                <div class="flex flex-wrap gap-2 justify-between text-[11px] tracking-[0.08em] uppercase text-site-subtle font-site-mono"><span>Reply Draft · AI</span><span>Example draft</span></div>
                <p class="m-0 text-[15px] text-site-draft-ink">Sorry about this — a sync regression shipped in 4.2 and is fixed in 4.2.1, rolling out now. Your decks are safe on our servers: update the app and they'll reappear. Reply here if anything is still missing.</p>
                <div class="text-[12px] text-site-subtle">Used Reply Context: “Sync incident 4.2”</div>
              </div>
              <div class="flex flex-wrap gap-2">
                <button type="button" disabled class="text-[14px] font-medium bg-site-primary text-white border-0 rounded-md py-[11px] px-4 min-h-11">Publish reply</button>
                <button type="button" disabled class="text-[14px] bg-transparent text-site-ink border border-site-border-strong rounded-md py-[11px] px-4 min-h-11">Edit draft</button>
                <button type="button" disabled class="text-[14px] bg-transparent text-site-muted border border-site-border-strong rounded-md py-[11px] px-4 min-h-11">Ignore</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-bs border-site-hairline border-be bg-site-alt">
        <div class="max-w-300 mx-auto py-24 px-6 flex flex-col gap-12">
          <div class="flex flex-col gap-[14px] max-w-180">
            <span class="text-[13px] font-medium tracking-[0.04em] text-site-primary-text">How it works</span>
            <h2 class="m-0 text-[length:clamp(32px,_4vw,_48px)] leading-[1.1] tracking-[-0.035em] font-semibold">Draft faster without giving up control.</h2>
          </div>
          <div class="grid grid-cols-[repeat(auto-fit,_minmax(min(100%,240px),_1fr))] gap-[1px] bg-site-hairline border border-site-hairline rounded-lg overflow-clip">
            <div class="bg-site-alt p-7 flex flex-col gap-[10px]">
              <span class="font-site-mono text-[12px] text-site-subtle">01</span>
              <h3 class="m-0 text-[18px] font-semibold tracking-[-0.3px]">Import Reviews</h3>
              <p class="m-0 text-[14px] text-site-muted">New App Store and Google Play reviews arrive with the App and store beside them.</p>
            </div>
            <div class="bg-site-alt p-7 flex flex-col gap-[10px]">
              <span class="font-site-mono text-[12px] text-site-subtle">02</span>
              <h3 class="m-0 text-[18px] font-semibold tracking-[-0.3px]">Draft replies</h3>
              <p class="m-0 text-[14px] text-site-muted">AI prepares a Reply Draft from the review and your Reply Context.</p>
            </div>
            <div class="bg-site-alt p-7 flex flex-col gap-[10px]">
              <span class="font-site-mono text-[12px] text-site-subtle">03</span>
              <h3 class="m-0 text-[18px] font-semibold tracking-[-0.3px]">Review changes</h3>
              <p class="m-0 text-[14px] text-site-muted">Edit, skip, or approve each draft before anything is published.</p>
            </div>
            <div class="bg-site-alt p-7 flex flex-col gap-[10px]">
              <span class="font-site-mono text-[12px] text-site-subtle">04</span>
              <h3 class="m-0 text-[18px] font-semibold tracking-[-0.3px]">Publish safely</h3>
              <p class="m-0 text-[14px] text-site-muted">Published Replies stay separate from drafts, so you always see what was sent.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="max-w-300 mx-auto py-28 px-6">
        <div id="analysis" class="scroll-mbs-6 flex flex-wrap gap-14 items-center">
          <div class="min-w-0 flex-[1_1_380px] flex flex-col gap-[18px]">
            <span class="text-[13px] font-medium tracking-[0.04em] text-site-primary-text">Review analysis</span>
            <h2 class="m-0 text-[length:clamp(32px,_4vw,_48px)] leading-[1.1] tracking-[-0.035em] font-semibold">Turn a queue of Reviews into a product signal.</h2>
            <p class="m-0 text-site-muted text-[17px]">Jev classifies every Review by topic, intent and reported severity. Luna proposes missing topics. Your team approves the catalogue — then drills from any chart segment to the Reviews behind it.</p>
            <a href="/docs/review-analysis/" class="text-[15px] font-medium text-site-link inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Read how analysis works →</a>
          </div>
          <div class="min-w-0 flex-[1_1_480px] border border-site-border rounded-xl bg-site-panel p-6 flex flex-col gap-[18px] shadow-site-panel">
            <div class="flex justify-between items-baseline flex-wrap gap-2">
              <span class="font-semibold">Top topics · illustrative preview</span>
              <span class="text-[12px] text-site-subtle font-site-mono">by reported severity</span>
            </div>
            <div class="flex flex-col gap-[14px]">
              <div class="flex flex-col gap-[6px]"><div class="flex justify-between text-[14px]"><span>Sync</span></div><div class="h-[10px] rounded-xs bg-site-track flex overflow-clip"><span class="w-[52%] bg-site-severity-high"></span><span class="w-[26%] bg-site-severity-medium"></span><span class="w-[8%] bg-site-severity-low"></span></div></div>
              <div class="flex flex-col gap-[6px]"><div class="flex justify-between text-[14px]"><span>Dark mode</span></div><div class="h-[10px] rounded-xs bg-site-track flex overflow-clip"><span class="w-[6%] bg-site-severity-high"></span><span class="w-[18%] bg-site-severity-medium"></span><span class="w-[40%] bg-site-severity-low"></span></div></div>
              <div class="flex flex-col gap-[6px]"><div class="flex justify-between text-[14px]"><span>Subscription price</span></div><div class="h-[10px] rounded-xs bg-site-track flex overflow-clip"><span class="w-[10%] bg-site-severity-high"></span><span class="w-[22%] bg-site-severity-medium"></span><span class="w-[14%] bg-site-severity-low"></span></div></div>
              <div class="flex flex-col gap-[6px]"><div class="flex justify-between text-[14px]"><span>Onboarding <span class="text-[11px] text-site-subtle border border-dashed border-site-severity-low rounded-xs py-0 px-[5px] ms-[6px]">pending</span></span></div><div class="h-[10px] rounded-xs bg-site-track flex overflow-clip opacity-60"><span class="w-[4%] bg-site-severity-high"></span><span class="w-[10%] bg-site-severity-medium"></span><span class="w-[16%] bg-site-severity-low"></span></div></div>
            </div>
            <div class="flex gap-4 text-[12px] text-site-muted flex-wrap">
              <span class="flex items-center gap-[6px]"><span class="w-2 h-2 rounded-[2px] bg-site-severity-high"></span>High</span>
              <span class="flex items-center gap-[6px]"><span class="w-2 h-2 rounded-[2px] bg-site-severity-medium"></span>Medium</span>
              <span class="flex items-center gap-[6px]"><span class="w-2 h-2 rounded-[2px] bg-site-severity-low"></span>Low</span>
            </div>
          </div>
        </div>
      </section>

      <section id="pricing" class="border-bs border-site-hairline">
        <div class="max-w-300 mx-auto py-28 px-6 flex flex-col gap-10">
          <div class="flex flex-wrap justify-between items-end gap-5">
            <h2 class="m-0 text-[length:clamp(32px,_4vw,_48px)] leading-[1.1] tracking-[-0.035em] font-semibold max-w-155">Free to start. Free to self-host.</h2>
            <a href="/pricing/" class="text-[15px] font-medium text-site-link inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Compare all plans →</a>
          </div>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-4">
            {cloudPlans.slice(0, 3).map((plan) => (
            <article class:list={['flex flex-col gap-3.5 rounded-lg border p-6', plan.id === 'starter' ? 'border-site-featured-border bg-site-featured' : 'border-site-border bg-site-surface']}>
              <h3 class="font-semibold">{plan.name}</h3>
              <p class="text-4xl font-semibold tracking-[-1px] tabular-nums">{plan.price}<span class="ms-1 text-[15px] font-normal text-site-subtle">/mo</span></p>
              <p class="text-sm text-site-muted">{plan.summary}</p>
            </article>
            ))}
            <div class="border border-dashed border-site-border-strong rounded-lg p-6 flex flex-col gap-[14px]">
              <span class="font-semibold">Self-hosted</span>
              <span class="text-[36px] font-semibold tracking-[-1px]">$0</span>
              <span class="text-[14px] text-site-muted">No billing limits · your AI provider · your Postgres and backups</span>
            </div>
          </div>
        </div>
      </section>

      <section class="border-bs border-site-hairline bg-site-alt">
        <div class="max-w-300 mx-auto py-28 px-6 flex flex-col gap-10">
          <div class="flex flex-col gap-[14px] max-w-180">
            <span class="text-[13px] font-medium tracking-[0.04em] text-site-primary-text">Store Connections</span>
            <h2 class="m-0 text-[length:clamp(32px,_4vw,_48px)] leading-[1.1] tracking-[-0.035em] font-semibold">Connect the store you use. Or both.</h2>
            <p class="m-0 text-site-muted text-[17px]">Each store exposes different permissions and review windows. The setup guides walk you through it before you paste a Store Credential — encrypted per Store Connection, never logged.</p>
          </div>
          <div class="grid grid-cols-[repeat(auto-fit,_minmax(min(100%,320px),_1fr))] gap-4">
            <div class="border border-site-border bg-site-surface rounded-lg p-7 flex flex-col gap-[14px]">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-[9px] bg-site-icon border border-site-border-strong flex items-center justify-center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4F5F6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 17 16 3"></path><path d="M6 13h12"></path><path d="m4 21 2-4"></path><path d="m18 17 2 4"></path></svg></span>
                <h3 class="m-0 text-[20px] font-semibold tracking-[-0.3px]">App Store</h3>
              </div>
              <p class="m-0 text-[15px] text-site-muted">Connect with an App Store Credential from App Store Connect. Apple exposes paginated customer reviews, and a Published Reply can take up to 24 hours to appear.</p>
              <a href="/docs/connect-app-store/" class="text-[14px] font-medium text-site-link inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">App Store guide →</a>
            </div>
            <div class="border border-site-border bg-site-surface rounded-lg p-7 flex flex-col gap-[14px]">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-[9px] bg-site-icon border border-site-border-strong flex items-center justify-center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F4F5F6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5v17l14-8.5z"></path></svg></span>
                <h3 class="m-0 text-[20px] font-semibold tracking-[-0.3px]">Google Play</h3>
              </div>
              <p class="m-0 text-[15px] text-site-muted">Use a service account with Reply to reviews permission. The API exposes written production reviews from the last week and limits replies to 350 characters.</p>
              <a href="/docs/connect-google-play/" class="text-[14px] font-medium text-site-link inline-flex items-center min-h-11 active:brightness-90 [@media(hover:hover)_and_(pointer:fine)]:hover:brightness-125">Google Play guide →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="border-bs border-site-hairline">
        <div class="max-w-300 mx-auto py-28 px-6 flex flex-wrap gap-12">
          <h2 class="min-w-0 flex-[1_1_320px] m-0 text-[length:clamp(32px,_4vw,_48px)] leading-[1.1] tracking-[-0.035em] font-semibold">Questions</h2>
          <div class="min-w-0 flex-[999_1_560px] flex flex-col">
            <details open class="border-bs border-site-border py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium tracking-[-0.2px]">Does AI publish replies automatically?</summary>
              <p class="mbs-3 text-site-muted max-w-160">No. AI drafting creates Reply Drafts only. Publishing remains an explicit action controlled by your team.</p>
            </details>
            <details class="border-bs border-site-border py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium tracking-[-0.2px]">Can ReviewInbox be self-hosted?</summary>
              <p class="mbs-3 text-site-muted max-w-160">Yes. The self-hosted stack runs with Docker Compose and keeps your data on your own infrastructure.</p>
            </details>
            <details class="border-bs border-site-border py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium tracking-[-0.2px]">Which stores are supported?</summary>
              <p class="mbs-3 text-site-muted max-w-160">App Store and Google Play. Each store has its own access and review-history limits.</p>
            </details>
            <details class="border-bs border-site-border border-be py-[22px] px-0">
              <summary class="min-h-11 active:text-site-muted [@media(hover:hover)_and_(pointer:fine)]:hover:text-site-body cursor-pointer text-[18px] font-medium tracking-[-0.2px]">How does Review analysis work?</summary>
              <p class="mbs-3 text-site-muted max-w-160">Jev classifies imported Reviews by topic, intent and reported severity. Luna proposes missing topics for human approval. Analysis stays separate from drafting and never publishes replies.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="max-w-300 mx-auto pbs-0 px-6 pbe-28">
        <div class="border border-site-border rounded-[20px] bg-site-panel p-[clamp(32px,_6vw,_72px)] flex flex-wrap gap-8 items-center justify-between shadow-site-panel">
          <div class="min-w-0 flex-[1_1_420px] flex flex-col gap-3">
            <h2 class="m-0 text-[length:clamp(28px,_3.4vw,_40px)] leading-[1.1] tracking-[-0.03em] font-semibold">Clear your review backlog this week.</h2>
            <p class="m-0 text-site-muted">Connect one App for free. AI never publishes on its own.</p>
          </div>
          <div class="flex flex-wrap gap-3">
